<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
</head>
<body style="margin:0;padding:0;background:#faf7f5;font-family:Arial,sans-serif;color:#1f1f1f;">
  <div style="max-width:600px;margin:0 auto;">
    <div style="background:#9f1239;padding:22px 24px;color:#fff;">
      <div style="font-size:22px;font-weight:800;letter-spacing:1px;">HUZA</div>
    </div>
    <div style="background:#ffffff;padding:24px;">
      <p style="margin:0 0 12px;">Hello <%= typeof name !== 'undefined' && name ? name : '' %>,</p>
      <h2 style="font-size:20px;margin:0 0 12px;"><%= title %></h2>
      <p style="margin:0 0 20px;line-height:1.55;white-space:pre-line;"><%= message %></p>
      <% if (typeof link !== 'undefined' && link) { %>
        <a href="<%= link %>" style="display:inline-block;background:#9f1239;color:#fff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:bold;">Open in HUZA</a>
      <% } %>
    </div>
    <div style="background:#f3efec;padding:18px 24px;font-size:12px;color:#6b6b6b;">
      Bookings made outside HUZA have no payment protection, no refunds and no replacement if a provider cancels.
    </div>
  </div>
</body>
</html>
