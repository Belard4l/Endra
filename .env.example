# ──────────────────────────────────────────────────────────────
# HUZA environment variables
# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (must include the database name, e.g. /huza)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/huza?retryWrites=true&w=majority"

# Upstash Redis (use the rediss:// TLS URL)
REDIS_DATABASE_URI="rediss://default:PASSWORD@coherent-jaybird-97846.upstash.io:6379"

# JWT secrets — long random strings (different from each other)
ACCESS_TOKEN_SECRET="change-me-to-a-long-random-string"
REFRESH_TOKEN_SECRET="change-me-to-another-long-random-string"

# Email (Gmail App Password works). Leave empty in development: emails + OTPs print in the terminal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SERVICE="gmail"
SMTP_USER=""
SMTP_PASS=""

# Flutterwave (leave FLUTTERWAVE_SECRET_KEY empty to use MOCK payments while developing)
FLUTTERWAVE_SECRET_KEY=""
# The "Secret hash" you set in Flutterwave → Settings → Webhooks
FLUTTERWAVE_SECRET_HASH=""
# Optional: where Flutterwave sends transfer results (defaults to the webhook set in the dashboard)
FLUTTERWAVE_TRANSFER_CALLBACK_URL=""
HUZA_SUPPORT_PHONE=""

# ImageKit (leave empty in development: images are stored inline, max 1.5 MB each)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Africa's Talking SMS (leave empty in development: SMS print in the terminal)
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# Frontend URLs (used in emails, redirects and CORS)
USER_UI_URL="http://localhost:3000"
SELLER_UI_URL="http://localhost:3001"
ADMIN_UI_URL="http://localhost:3002"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# Only set in production, e.g. ".huza.rw", so cookies work across subdomains
COOKIE_DOMAIN=""

# Service ports (defaults shown)
PORT=8080
AUTH_SERVICE_PORT=6001
CATALOG_SERVICE_PORT=6002
BOOKING_SERVICE_PORT=6003
ADMIN_SERVICE_PORT=6004

# Frontends call the gateway through this (Next.js reads NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_SERVER_URI="http://localhost:8080"
NEXT_PUBLIC_USER_UI_URL="http://localhost:3000"
NEXT_PUBLIC_SELLER_UI_URL="http://localhost:3001"
